<Window x:Class="YTShortsManager.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История скачиваний" Height="650" Width="750"
        Background="#0B0E14" Foreground="White"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="icon.ico">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="История скачиваний" FontSize="24" FontWeight="Bold" Foreground="#FF0033" Margin="0,0,0,20"/>

        <ListView x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#151A25" CornerRadius="12" Padding="12" Cursor="Hand" MouseLeftButtonUp="Item_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image Source="{Binding ThumbnailUrl}" Width="140" Height="80" Stretch="UniformToFill" Margin="0,0,20,0">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,140,80" RadiusX="8" RadiusY="8"/>
                                </Image.Clip>
                            </Image>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="White" TextWrapping="Wrap" MaxHeight="45"/>
                                <TextBlock Text="{Binding Time}" Foreground="#8892B0" FontSize="13" Margin="0,6,0,6"/>
                                <TextBlock Text="{Binding Path}" Foreground="#00E676" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>