<Window x:Class="YTShortsManager.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История скачиваний" Height="680" Width="860" MinHeight="480" MinWidth="700"
        Background="{StaticResource AppBgBrush}" Foreground="{StaticResource AppTextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="icon.ico">

    <Grid ClipToBounds="True">
        <Ellipse Width="520" Height="520" Margin="-260,-280,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#44FF0033" Offset="0"/>
                    <GradientStop Color="#00FF0033" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="26,22,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AppAccentGradientBrush}">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HistoryTitleText" Text="История скачиваний" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock x:Name="HistoryHintText" Text="Нажмите на карточку, чтобы открыть файл"
                                   FontSize="12" Foreground="{StaticResource AppMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#121A29" BorderBrush="#222D42" BorderThickness="1"
                        CornerRadius="10" Padding="12,7">
                    <TextBlock Foreground="#8FA0C4" FontSize="12" FontWeight="SemiBold">
                        <Run x:Name="FilesLabelRun" Text="Файлов: "/><Run Text="{Binding ElementName=HistoryList, Path=Items.Count, Mode=OneWay}" Foreground="White"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- Список -->
            <ListView x:Name="HistoryList" Grid.Row="1" Margin="0,18,0,0"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource AppCardBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="12" Cursor="Hand" MouseLeftButtonUp="Item_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Превью -->
                                <Grid Width="150" Height="84">
                                    <Border Background="#151D2E" CornerRadius="10"/>
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                               Foreground="#2E3A54" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,150,84" RadiusX="10" RadiusY="10"/>
                                        </Image.Clip>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThumbnailUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>

                                <!-- Текст -->
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5"
                                               Foreground="{StaticResource AppTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="#5A6580" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource AppMutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="#4E9C7A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#6FD3A4" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#4C5773" VerticalAlignment="Center" Margin="4,0"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                         Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#5A2434"/>
                                <Setter TargetName="Card" Property="Background" Value="#141B2B"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
