<Window x:Class="YTShortsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YT Shorts Manager" Height="880" Width="650"
        Background="#0B0E14" Foreground="White"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <tb:TaskbarIcon x:Key="MyNotifyIcon" ToolTipText="YT Shorts Manager" TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть программу" Click="MyNotifyIcon_TrayMouseDoubleClick"/>
                    <MenuItem Header="Выход" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Style x:Key="WindowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8892B0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2E3547"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF0033"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#2E3547" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E3547"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E4A63"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF0033"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3355"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#00E676"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#8892B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/> 
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#151A25" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="YT Shorts Manager" Foreground="#8892B0" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Style="{StaticResource WindowBtnStyle}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="🗖" Style="{StaticResource WindowBtnStyle}" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="✕" Style="{StaticResource CloseBtnStyle}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0 Заголовок -->
                <RowDefinition Height="Auto"/> <!-- 1 URL -->
                <RowDefinition Height="Auto"/> <!-- 2 Галочки -->
                <RowDefinition Height="Auto"/> <!-- 3 Кнопка Скачать -->
                <RowDefinition Height="Auto"/> <!-- 4 Прогресс-бар -->
                <RowDefinition Height="Auto"/> <!-- 5 Очередь -->
                <RowDefinition Height="Auto"/> <!-- 6 Папка -->
                <RowDefinition Height="Auto"/> <!-- 7 НИЖНИЕ КНОПКИ -->
                <RowDefinition Height="*"/>    <!-- 8 Логи -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="YouTube Downloader" FontSize="28" FontWeight="Black" 
                       HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF0033" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlTextBox" VerticalContentAlignment="Center"/>
                <Button x:Name="PasteButton" Content="Вставить" Grid.Column="1" Width="90" Margin="10,0,0,0" Click="PasteButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,0,0,10">
                <CheckBox x:Name="ClipboardToggle" Content="Авто-вставка" IsChecked="True" Margin="0,0,20,0"/>
                <CheckBox x:Name="StartupToggle" Content="Запускать с Windows" IsChecked="False"/>
            </StackPanel>

            <Button x:Name="DownloadButton" Grid.Row="3" Content="СКАЧАТЬ ВИДЕО" Style="{StaticResource PrimaryButton}" Click="DownloadButton_Click" Margin="0,0,0,10"/>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="DownloadProgress" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#00E676" FontWeight="Bold" FontSize="14"/>
            </Grid>

            <!-- ОЧЕРЕДЬ ЗАГРУЗОК -->
            <Border Grid.Row="5" Background="#151A25" CornerRadius="8" Padding="5" Margin="0,0,0,10" Height="80">
                <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="#8892B0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" Grid.Column="1" Foreground="#00E676" Margin="10,0,0,0" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="6" Background="#151A25" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Папка:" VerticalAlignment="Center" Foreground="#8892B0" FontSize="14" Margin="0,0,10,0"/>
                    <TextBox x:Name="PathTextBox" Grid.Column="1" VerticalContentAlignment="Center"/>
                    <Button Content="Обзор" Grid.Column="2" Width="80" Margin="10,0,0,0" Click="BrowseButton_Click"/>
                </Grid>
            </Border>

            <!-- НИЖНИЕ КНОПКИ (ТЕПЕРЬ ОНИ ТОЧНО НА ВИДУ) -->
            <Border Grid.Row="7" Background="#151A25" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="HistoryButton" Content="📜 История" Width="120" Click="HistoryButton_Click" Margin="5"/>
                    <Button x:Name="ClearCacheButton" Content="🧹 Очистить кэш" Width="140" Click="ClearCacheButton_Click" Margin="5" Background="#883333"/>
                    <Button x:Name="UpdateButton" Content="⬆️ Обновить yt-dlp" Width="150" Click="UpdateButton_Click" Margin="5" Background="#0055AA"/>
                    <Button x:Name="AppUpdateButton" Content="📦 Обновить программу" Width="170" Click="AppUpdateButton_Click" Margin="5" Background="#006644"/>
                </WrapPanel>
            </Border>

            <Border Grid.Row="8" Background="#000000" CornerRadius="12" Padding="5" MinHeight="80">
                <TextBox x:Name="LogTextBox" Background="Transparent" BorderThickness="0" Foreground="#00FF00" 
                         FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         TextWrapping="Wrap" Padding="10"/>
            </Border>
        </Grid>
    </Grid>
</Window>